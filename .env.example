# --- Core ---
DATABASE_URL=postgresql://caste:caste@localhost:5432/caste
REDIS_URL=redis://localhost:6379/0
NODE_ENV=development

# --- Auth ---
AUTH_SECRET=change-me-32-bytes-min
SESSION_TTL_HOURS=720
AUTH_PROVIDER=magic-link            # magic-link | passkey
GOOGLE_CLIENT_ID=                   # optional OAuth (PKCE). Empty = disabled.
GOOGLE_CLIENT_SECRET=

# --- Storage (S3-compatible; empty = local ./data/uploads) ---
STORAGE_DRIVER=local                # local | s3
STORAGE_LOCAL_PATH=./data/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email ---
EMAIL_DRIVER=demo                   # demo (logs to console/Mailpit) | smtp
EMAIL_FROM=CASTE <no-reply@caste.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# --- Push ---
PUSH_DRIVER=none                    # none | webpush
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=

# --- AI ---
AI_PROVIDER=demo                    # demo | openai | anthropic | google
AI_MODEL=                           # override per-provider default
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AI_COST_BUDGET_USD_MONTH=5
AI_TIMEOUT_MS=15000

# --- Integrations ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Payments (billing foundation) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FAMILY=
STRIPE_PRICE_CARE=

# --- Observability ---
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
